---
const alt = 'iAtur, aplikasi pengaturan dan optimizer native untuk macOS';
---

<figure class="iatur-featured-image">
	<button
		class="iatur-featured-image-button"
		type="button"
		data-iatur-screenshot-open
		data-full="/uploads/iatur/iatur-macos-app-featured-1672.webp"
		data-alt={alt}
		aria-label={`Perbesar gambar: ${alt}`}
	>
		<img
			src="/uploads/iatur/iatur-macos-app-featured-836.webp"
			srcset="/uploads/iatur/iatur-macos-app-featured-836.webp 836w, /uploads/iatur/iatur-macos-app-featured-1672.webp 1672w"
			sizes="(max-width: 752px) calc(100vw - 2rem), 720px"
			alt={alt}
			width="1672"
			height="941"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<span class="iatur-screenshot-zoom" aria-hidden="true">
			<svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5" /><path d="m15 15 5 5M10.5 8v5M8 10.5h5" /></svg>
		</span>
	</button>
</figure>
