---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { resolvePostHeroImage } from '../lib/cms';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, seoTitle, seoDescription, seoImage, pubDate, updatedDate, heroImage, body } = Astro.props;
const heroAlt = seoTitle || title;
const resolvedHeroImage = resolvePostHeroImage({ heroImage, body: body || '' });
---

<html lang="id">
	<head>
		<BaseHead title={seoTitle || title} description={seoDescription || description} image={seoImage || resolvedHeroImage} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: 100%;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: 100%;
				margin: auto;
				padding: 1.25rem 0 2rem;
				box-sizing: border-box;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.75rem;
				padding: 1.5rem 0 1rem;
				text-align: center;
			}
			.title h1 {
				margin: 0 auto 0.75rem;
				max-width: 18ch;
				line-height: 1.08;
			}
			.date {
				margin-bottom: 0.65rem;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				line-height: 1.45;
			}
			.last-updated-on {
				font-style: italic;
			}
			@media (max-width: 620px) {
				.title {
					margin-bottom: 1.25rem;
					padding-top: 1rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{resolvedHeroImage && <img width={1020} height={510} src={resolvedHeroImage} alt={heroAlt} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Diperbarui pada <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
