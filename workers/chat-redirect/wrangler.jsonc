{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "arunajr-chat-redirect",
	"main": "src/index.js",
	"compatibility_date": "2026-10-06",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "chat.arunajr.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
