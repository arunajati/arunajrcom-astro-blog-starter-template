{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arunajrcom-astro-blog-starter-template",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "IATUR_STATS",
			"database_name": "arunajrcom-iatur-stats",
			"database_id": "6a5fd153-1ead-4a8c-987e-6a92af4492e4",
			"migrations_dir": "migrations/iatur-stats"
		}
	],
	"vars": {
		"CMS_GITHUB_OWNER": "arunajati",
		"CMS_GITHUB_REPO": "arunajrcom-astro-blog-starter-template",
		"CMS_GITHUB_BRANCH": "main"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
